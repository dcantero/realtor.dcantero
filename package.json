{
  "name": "realtor-dcantero",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check-node": "node scripts/check-node.mjs",
    "predev": "npm run -s check-node",
    "prestart": "npm run -s check-node",
    "prebuild": "npm run -s check-node",
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --conditions development server.js",
    "build": "react-router build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server.js",
    "typecheck": "react-router typegen && tsc -b"
  },
  "dependencies": {
    "@react-router/express": "^8.4.0",
    "@react-router/node": "^8.4.0",
    "@vis.gl/react-google-maps": "^1.10.1",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "isbot": "^5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/google.maps": "^3.66.5",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
